# URL of the Airflow instance (used by Vite dev proxy and for direct navigation)
VITE_AIRFLOW_API_URL=https://main-airflow.somename.ru

# API prefix (defaults to /api/v1 if not set)
VITE_AIRFLOW_API_PREFIX=/api/v1

# Comma-separated hosts allowed to reach the dev server (needed behind an
# ingress: Vite otherwise rejects requests with "Blocked request. This host
# (...) is not allowed"). Leave empty for plain localhost development.
VITE_ALLOWED_HOSTS=
